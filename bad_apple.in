units           metal
atom_style      atomic
dimension       2
boundary        p p p

# Define a crystal/grid spacing (e.g. lattice spacing ~ 1.8 Angstroms)
region          box block 0 480 0 360 -0.5 0.5 units box
create_box      1 box

create_atoms    1 random 100000 424242 box
mass            1 12.011

# Pure electrostatic/screened Coulomb repulsion!
# pair_style yukawa <kappa: inverse screening length> <cutoff>
pair_style      yukawa 1.0 4.0
pair_coeff      1 1 5.0 4.0

neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

minimize        1.0e-4 1.0e-6 500 5000
reset_timestep  0

fix		2d all enforce2d

# Custom Bad Apple steering fix ✨
fix             BA all bad_apple bad_apple.mp4 100 5.0 480 360

# Damped dynamics with displacement limit
fix             lang all langevin 2500.0 2500.0 0.1 424242
fix             nve all nve/limit 0.1

thermo          100
thermo_style    custom step temp pe ke press

dump            1 all xyz 50 bad_apple_sim.xyz


timestep        0.001
run             325000
